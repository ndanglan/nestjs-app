  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "GoogleAuthDto": {
        "type": "object",
        "properties": {
          "id_token": {
            "type": "string",
            "example": "eyJhbGci..",
            "description": "The id token from Google OAuth2"
          }
        },
        "required": [
          "id_token"
        ]
      },
      "ManualSignupDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "Tên người dùng"
          },
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "Email người dùng"
          },
          "password": {
            "type": "string",
            "example": "Password123!",
            "description": "Mật khẩu người dùng. Phải có ít nhất 8 ký tự, chứa ít nhất một chữ cái viết hoa, một số và một ký tự đặc biệt."
          },
          "confirm_password": {
            "type": "string",
            "example": "Password123!",
            "description": "Xác nhận mật khẩu"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "confirm_password"
        ]
      },
      "RoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "example": "admin",
            "description": "Vai trò người dùng"
          }
        },
        "required": [
          "role"
        ]
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Team Meeting"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "example": "2024-03-20T10:00:00Z"
          },
          "endTime": {
            "type": "string",
            "example": "2024-03-20T11:00:00Z"
          },
          "isAllDay": {
            "type": "boolean",
            "default": false
          },
          "recurrence": {
            "type": "string",
            "enum": [
              "NONE",
              "DAILY",
              "WEEKLY",
              "MONTHLY",
              "YEARLY",
              "CUSTOM"
            ],
            "default": "NONE"
          },
          "recurrenceRule": {
            "type": "string"
          },
          "reminderType": {
            "type": "string",
            "enum": [
              "NONE",
              "EMAIL",
              "PUSH_NOTIFICATION"
            ],
            "default": "NONE"
          },
          "reminderTime": {
            "type": "number"
          },
          "categoryId": {
            "type": "number"
          },
          "color": {
            "type": "string",
            "example": "#FF5733"
          }
        },
        "required": [
          "title",
          "startTime",
          "endTime",
          "recurrence",
          "reminderType"
        ]
      },
      "UpdateEventDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Team Meeting"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "example": "2024-03-20T10:00:00Z"
          },
          "endTime": {
            "type": "string",
            "example": "2024-03-20T11:00:00Z"
          },
          "isAllDay": {
            "type": "boolean",
            "default": false
          },
          "recurrence": {
            "type": "string",
            "enum": [
              "NONE",
              "DAILY",
              "WEEKLY",
              "MONTHLY",
              "YEARLY",
              "CUSTOM"
            ],
            "default": "NONE"
          },
          "recurrenceRule": {
            "type": "string"
          },
          "reminderType": {
            "type": "string",
            "enum": [
              "NONE",
              "EMAIL",
              "PUSH_NOTIFICATION"
            ],
            "default": "NONE"
          },
          "reminderTime": {
            "type": "number"
          },
          "categoryId": {
            "type": "number"
          },
          "color": {
            "type": "string",
            "example": "#FF5733"
          }
        }
      }
    }
  }
